.opencode/
agent/.opencode/

# OS
.DS_Store
.entire/

# Firebase
.firebase/

# Environment files
.env
.env.*
!.env.example

# Logs
*.log


# OpenTrace index (legacy location)
otindex.db
otindex.db.wal

# Developer Files
config.yaml

# Local graph state: the index DB, the document corpus, and compiled vaults.
# Machine-specific and often large — running `opentraceai index` or `vault
# ingest` anywhere in this repo must never leave committable files behind.
# (The negation below predates this rule by some margin: `config.yaml` was
# being re-included from an ignore that was never actually written.)
.opentrace/
!.opentrace/config.yaml

# Built docs site — `mkdocs build` output. CI publishes it; it is never a
# source artefact, and committing it makes any docs edit look like a
# thousand-file diff.
site/

# Auto Claude generated files
.auto-claude/
.auto-claude-security.json
.auto-claude-status
.claude_settings.json
.worktrees/
.security-key
logs/security/
